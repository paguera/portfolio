# --- PORTFOLIO: DATABASE ---
PORTFOLIO_DB_USER=portfolio_user
PORTFOLIO_DB_PASSWORD=your_secure_db_password
PORTFOLIO_DB_NAME=portfolio

# --- PORTFOLIO: BACKEND API ---
PORT=3000
DB_HOST=portfolio-db
DB_USER=portfolio_user
DB_PASSWORD=your_secure_db_password
DB_NAME=portfolio
DB_PORT=5432
DATABASE_URL=postgres://portfolio_user:your_secure_db_password@portfolio-db:5432/portfolio
JWT_SECRET=your_jwt_secret_key_here
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_app_password
MAIL_TO=recipient@example.com

# --- PORTFOLIO: FRONTENDS (BUILD ARGS & RUNTIME) ---
VITE_BASE_URL_VISITEURS=https://portfolio-api.example.com/api
VITE_BASE_URL_ADMIN=https://portfolio-api.example.com

# --- NETWORKING & SECURITY ---
TAILSCALE_IP=100.x.y.z
